PORT=4010
HOST=127.0.0.1
# Shared with the backend as PHONE_GATEWAY_TOKEN.
GATEWAY_TOKEN=
DEVICES_FILE=devices.json
SCRIPTS_DIR=scripts
STATE_DIR=state
ADB_PATH=adb

# Workspace automation token (GET /workspace/automation_token?expiration_period=no_exp).
# Leave empty to use a logged-in xcli on this host instead (local tests only).
MULTILOGIN_TOKEN=
MULTILOGIN_XCLI_PATH=
MULTILOGIN_API_URL=https://api.multilogin.com
# Disable ADB after this much idle time; 0 keeps it on.
ADB_IDLE_DISABLE_MS=600000

# Empty values turn LLM recovery and script fixes off; the gateway then fails safely before Send.
OPENROUTER_API_KEY=
GATEWAY_RECOVERY_MODEL=x-ai/grok-4.3
GATEWAY_FIXER_MODEL=x-ai/grok-4.7
LLM_SCREENSHOTS=true
